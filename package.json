{
  "name": "react-webcam",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "release": "pnpm --filter @cp949/react-webcam release",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "test": "pnpm readme:package:check && turbo run test",
    "check-types": "turbo run check-types",
    "readme:package": "node scripts/generate-package-readme.mjs",
    "readme:package:check": "node scripts/generate-package-readme.mjs --check",
    "test:chrome83": "node scripts/run-chrome83-floor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "oxlint": "1.88.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "7.0.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.18.0"
  }
}
