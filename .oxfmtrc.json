{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": false,
  "jsxSingleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".turbo/",
    "coverage/",
    ".next/",
    "build/",
    "out/",
    "pnpm-lock.yaml",
    "CHANGELOG.md"
  ]
}
